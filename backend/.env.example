# Flask Environment Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Database Configuration (Optional for initial health check, required for persistence)
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/skillsetu_db
DATABASE_URL=

# CORS Configuration (Comma-separated list of allowed origins or *)
CORS_ORIGINS=http://localhost:5173,https://ayush35099-cloud.github.io
